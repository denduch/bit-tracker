{
  "manifest_version": 3,
  "name": "Bit Tracker Extension",
  "version": "1.0",
  "description": "Chrome extension with popup and service worker",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bit Tracker"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
